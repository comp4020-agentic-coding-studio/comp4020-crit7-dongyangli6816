---
// The front door: what this is, in a line, and the way in. It stays a
// server-rendered page (not prerendered) because the CI deploy step probes
// it, including Astro's origin check on a POST, which prerendered routes skip.
import Base from "../layouts/Base.astro";
import { SESSION } from "../lib/enrolment";
---

<Base title="ANU Enrolment (prototype)">
  <main id="main" class="home">
    <p class="eyebrow">{SESSION}</p>
    <h1>Enrolment that tells you before you press the button</h1>
    <p class="lede">
      Find a course by its code, name or a keyword, see whether you can take it and when it meets, and enrol in one
      step. A redesign of the ANU enrolment system as a student prototype.
    </p>
    <p class="home__actions">
      <a class="button" href="/enrol/">Choose your courses</a>
      <a href="/readme/">How it was designed</a>
    </p>
  </main>
</Base>
